# Adaptive Web Security Gateway — Environment Configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────────────────────
# 📋 HƯỚNG DẪN SỬ DỤNG:
#   1. Copy file này: cp .env.example .env
#   2. Điền vào tất cả giá trị có dấu <CHANGE_ME>
#   3. KHÔNG BAO GIỜ commit file .env lên Git
#   4. File .env.example này được commit thay thế (không chứa credentials thật)
# ─────────────────────────────────────────────────────────────────────────────

# =============================================================================
# DJANGO CORE
# =============================================================================
# Tạo SECRET_KEY mới bằng: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=<CHANGE_ME_generate_with_python>

# Tạo JWT_SECRET_KEY mới bằng: openssl rand -hex 32
JWT_SECRET_KEY=<CHANGE_ME_openssl_rand_hex_32>

# =============================================================================
# TELEGRAM ALERT (Real-time attack notifications)
# =============================================================================
# Tạo bot mới tại: https://t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=<CHANGE_ME_botfather_token>
# Lấy Chat ID: Message bot rồi call https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=<CHANGE_ME_your_chat_id>

# =============================================================================
# DJANGO SETTINGS
# =============================================================================
DEBUG=False
ALLOWED_HOSTS=your-domain.duckdns.org,localhost,127.0.0.1

# Session TTL đồng bộ với JWT (giây)
SESSION_TTL=3600

# =============================================================================
# DJANGO SECURITY FLAGS
# =============================================================================
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# =============================================================================
# DATABASE (AWS RDS MySQL hoặc local MySQL)
# =============================================================================
DB_NAME=<CHANGE_ME_database_name>
DB_USER=<CHANGE_ME_db_username>
DB_PASSWORD=<CHANGE_ME_strong_password>
# AWS RDS format: yourdb.xxxx.ap-northeast-1.rds.amazonaws.com
# Local Docker format: db (tên service trong docker-compose)
DB_HOST=<CHANGE_ME_db_host>
DB_PORT=3306

# =============================================================================
# REDIS
# Lua Gateway dùng db=0, Django dùng db=1 để không conflict
# =============================================================================
REDIS_URL=redis://redis:6379/1

# =============================================================================
# AWS S3 — Static & Media Storage
# =============================================================================
USE_S3=False
AWS_STORAGE_BUCKET_NAME=<CHANGE_ME_s3_bucket_name>
AWS_S3_REGION_NAME=ap-northeast-1

# =============================================================================
# GRAFANA (Dashboard)
# =============================================================================
# QUAN TRỌNG: Đổi password này! KHÔNG dùng giá trị mặc định trên production
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<CHANGE_ME_strong_grafana_password>

# =============================================================================
# GATEWAY — RATE LIMIT (Local leaky bucket per worker)
# Chống DDoS cục bộ (Spike Catcher). Cho phép tối đa N req/giây.
# =============================================================================
RATE_LIMIT_RPS=30
RATE_LIMIT_BURST=60

# =============================================================================
# GATEWAY — AUTO BLACKLIST
# IP bị rate-limit AUTO_BL_THRESHOLD lần trong AUTO_BL_WINDOW giây → bị ban AUTO_BL_DURATION giây
# =============================================================================
AUTO_BL_THRESHOLD=5
AUTO_BL_WINDOW=60
AUTO_BL_DURATION=3600

# =============================================================================
# GATEWAY — REDIS RATE LIMIT (Distributed sliding window)
# Chống Crawler/Scraper. Cho phép tối đa REDIS_RATE_LIMIT req / REDIS_RL_WINDOW giây
# =============================================================================
REDIS_RATE_LIMIT=150
REDIS_RL_WINDOW=60

# =============================================================================
# GATEWAY — BRUTE FORCE PROTECTION
# Sau BRUTE_FORCE_MAX_ATTEMPTS lần sai trong BRUTE_FORCE_WINDOW giây → lockout BRUTE_FORCE_COOLDOWN giây
# =============================================================================
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_WINDOW=300
BRUTE_FORCE_RISK_PENALTY=80
BRUTE_FORCE_COOLDOWN=3600

# =============================================================================
# GATEWAY — RISK ENGINE
# RISK_LIMIT_THRESHOLD : risk score >= giá trị này → HTTP 429
# RISK_BLOCK_THRESHOLD : risk score >= giá trị này → HTTP 403
# =============================================================================
RISK_LIMIT_THRESHOLD=50
RISK_BLOCK_THRESHOLD=80

# =============================================================================
# GATEWAY — IP REPUTATION DECAY (NEW)
# RISK_DECAY_FACTOR  : Hệ số giảm điểm reputation mỗi giờ (0.0-1.0, 0 = không decay)
# RISK_DECAY_ENABLED : Bật/tắt cơ chế decay (true/false)
# =============================================================================
RISK_DECAY_FACTOR=0.1
RISK_DECAY_ENABLED=false
