# =============================================================================
# Adaptive Security Gateway — .gitignore
# =============================================================================

# ── CREDENTIALS & SECRETS (NEVER COMMIT) ────────────────────────────────────
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx

# ── PYTHON ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── DJANGO ────────────────────────────────────────────────────────────────────
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# ── DOCKER ───────────────────────────────────────────────────────────────────
logs/
*.tar

# ── IDE ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── PYTEST ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── NODE (nếu có frontend) ───────────────────────────────────────────────────
node_modules/
npm-debug.log*
