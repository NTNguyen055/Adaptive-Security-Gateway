      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "asg-prometheus"
          },
          "expr": "sum(rate(nginx_http_requests_total{status=~\"403|429\"}[5m])) / clamp_min(sum(rate(nginx_http_requests_total[5m])), 0.000001)",
