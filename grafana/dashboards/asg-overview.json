  "panels": [
    {
      "id": 1,
      "title": "Gateway scrape UP",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "asg-prometheus"
      },
      "description": "1 = Prometheus can scrape the Gateway; 0 = scrape failed.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "asg-prometheus"
          },
          "expr": "up{job=\"adaptive_security_gateway\"}",
          "refId": "A",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
