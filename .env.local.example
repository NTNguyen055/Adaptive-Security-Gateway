# LOCAL DEVELOPMENT ONLY. Never reuse these settings in AWS/production.
# Create .env.local automatically with: python scripts/init-local-env.py
# Do not commit .env.local or paste its secrets into chat.
APP_ENV=local
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
SECRET_KEY=__GENERATE_SECRET_KEY__
JWT_SECRET_KEY=__GENERATE_JWT_SECRET__
SESSION_TTL=3600

# Local MySQL container — no host port published, no TLS over private dev bridge.
DB_NAME=adaptive_gateway_dev
DB_USER=adaptive_user
DB_PASSWORD=__GENERATE_DB_PASSWORD__
MYSQL_ROOT_PASSWORD=__GENERATE_MYSQL_ROOT_PASSWORD__
DB_HOST=db
DB_PORT=3306

REDIS_URL=redis://redis:6379/1
USE_S3=False

# Telegram is optional for local experiments; keep blank if not configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Grafana, optional: docker compose --profile monitoring ...
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__GENERATE_GRAFANA_PASSWORD__

RATE_LIMIT_RPS=30
RATE_LIMIT_BURST=60
REDIS_RATE_LIMIT=150
REDIS_RL_WINDOW=60
AUTO_BL_THRESHOLD=5
AUTO_BL_WINDOW=60
AUTO_BL_DURATION=3600
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_WINDOW=300
BRUTE_FORCE_RISK_PENALTY=80
BRUTE_FORCE_COOLDOWN=3600
RISK_LIMIT_THRESHOLD=50
RISK_BLOCK_THRESHOLD=80
RISK_DECAY_FACTOR=0.1
RISK_DECAY_ENABLED=false
